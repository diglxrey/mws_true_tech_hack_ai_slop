{
  "name": "@snipeter/plugin-callout",
  "version": "0.1.0",
  "type": "module",
  "private": false,
  "description": "Callout block plugin for the Snipeter editor (note / tip / warning / danger)",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint"
  },
  "peerDependencies": {
    "@blocknote/core": "^0.47.0",
    "@blocknote/react": "^0.47.0",
    "@snipeter/editor-sdk": "^0.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@blocknote/core": "^0.47.3",
    "@blocknote/react": "^0.47.3",
    "@snipeter/editor-sdk": "workspace:*",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3"
  }
}
