# =============================================================================
# Next.js (`apps/web`) — copy to `.env.local` in this directory.
# Values here override the root `.env` for the web app only.
# =============================================================================

# Public API origin (browser + wiki WebSocket collab). Keep reachable from the user’s browser.
# Browser-reachable Nest base (no trailing slash).
# Docker + nginx (:80): same origin — WS и прямые ссылки на /api/v1.
NEXT_PUBLIC_API_URL=http://localhost
# Локально `pnpm dev` (Next :3000, API :3001, без nginx):
#NEXT_PUBLIC_API_URL=http://localhost:3001

# BFF proxy → Nest (server-side). Local dev on host:
#API_URL_INTERNAL=http://127.0.0.1:3001
# Docker Compose (web container → api service):
API_URL_INTERNAL=http://api:3001

# OIDC for Auth.js (must match Dex `issuer` / discovery URL in the browser).
OIDC_ISSUER=http://localhost:5556/dex

AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
AUTH_DEX_CLIENT_ID=snippeter-web
AUTH_DEX_CLIENT_SECRET=snippeter-web-secret-dev

# Behind reverse proxy (e.g. nginx on :80) — иначе Auth.js: UntrustedHost на /api/auth/*
AUTH_URL=http://localhost
AUTH_TRUST_HOST=true
