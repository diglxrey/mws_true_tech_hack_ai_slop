{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      { "include": "**/*.sql", "watchAssets": true },
      { "include": "sdk/**/*.js", "watchAssets": true }
    ],
    "watchAssets": true
  }
}
