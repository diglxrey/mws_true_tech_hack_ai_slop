# API
PORT=3001
CORS_ORIGIN=http://localhost

# Meta DB (snippets + variables metadata)
META_DATABASE_URL=postgresql://snippeter:snippeter@postgres-meta:5432/snippeter_meta

REDIS_URL=redis://redis:6379

# Next.js (apps/web) — browser calls API
INTERNAL_API_BASE_URL=http://localhost/api/v1
LLM_API_KEY=
LLM_BASE_URL=https://api.gpt.mws.ru/v1/
LLM_PROVIDER=openai
LLM_MODEL=deepseek-r1-distill-qwen-32b
INJECTION_FILTER_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST="https://cloud.langfuse.com"

MWS_TOKEN=uskTKqv1hqoAZ7SOB5WxbE3
MWS_FUSION_BASE_URL=https://tables.mws.ru/
MWS_SPACE_ID=spcgHfh4dbamM

# S3-compatible file storage (MinIO)
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=snippeter
S3_SECRET_KEY=snippeter_secret
S3_BUCKET=snippeter-files
# --- OIDC / Auth (Dex in docker-compose on port 5556) ---
# Issuer URL — must match docker/dex/config.yaml `issuer` field
OIDC_ISSUER=http://localhost:5556/dex
# Audience for the API: the Dex client ID used by the web app
OIDC_AUDIENCE=snippeter-web
# JWKS endpoint — used by apps/api to verify JWT signatures
OIDC_JWKS_URI=http://dex:5556/dex/keys

# Auth.js (next-auth) settings for apps/web
AUTH_SECRET=tNiPO0cZ/edTO7qvMDwY7sgQsHYUEktEQjc9/+84baI=
AUTH_DEX_CLIENT_ID=snippeter-web
AUTH_DEX_CLIENT_SECRET=snippeter-web-secret-dev

